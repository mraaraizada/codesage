{
  "name": "codesage",
  "version": "0.1.0",
  "description": "CodeSage — Intelligent code understanding and debugging. An AI software engineer agent that inspects a codebase, investigates a bug report with real evidence, proposes a verified patch, and reports the outcome.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "codesage": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "bash scripts/demo.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "ignore": "^5.3.2",
    "openai": "^7.47.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
