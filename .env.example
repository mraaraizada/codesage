# CodeSage environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (set ONE of these; GROQ_API_KEY takes priority if both are set) ---

# Anthropic Claude.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq (OpenAI-compatible Chat Completions API, fast open-weight tool-calling models).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: a second Groq key, tried automatically if the primary one above hits a rate/quota
# limit (daily token cap, etc.) with no tool-call progress yet made.
GROQ_API_KEY_2=

# Optional: OpenRouter (also OpenAI-compatible), tried last — a free-tier model used only as a
# fallback once both Groq keys above are exhausted. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional: force a specific provider ("anthropic" | "groq"). If unset, auto-detects from
# whichever API key above is present (GROQ_API_KEY wins if both are set).
LLM_PROVIDER=

# Optional: override the default model used for reasoning. If unset, a sensible per-provider
# default is used (see src/llm/client.ts) — currently claude-sonnet-4-5-20250929 for Anthropic and
# openai/gpt-oss-120b for Groq.
CODESAGE_MODEL=

# Optional: max agentic tool-call iterations during investigation (default 12). Leave unset to use
# the default; a smaller model (e.g. Groq's gpt-oss-120b) sometimes needs most of this budget on a
# real multi-file project to reach a confident verdict instead of degrading to "inconclusive".
CODESAGE_MAX_ITERATIONS=

# Optional: timeout (ms) for each test-run subprocess (default 120000).
CODESAGE_TEST_TIMEOUT_MS=120000
