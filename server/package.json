{
  "name": "codesage-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP server exposing the CodeSage pipeline (src/pipeline.ts) over REST for the web UI.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
